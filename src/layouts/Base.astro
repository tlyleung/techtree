---
import { SITE, url } from "../site";
import "../styles/global.css";

interface Props { title?: string; description?: string; wide?: boolean }
const { title, description = SITE.description, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
  </head>
  <body class:list={{ wide }}>
    <header class="site-header">
      <a class="brand" href={url("/")}>
        <span class="brand-mark" aria-hidden="true">T</span>
        <span>{SITE.title}</span>
      </a>
      <nav>
        <a href={url("methodology/")}>Methodology</a>
        <a href={SITE.repo}>GitHub</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>Years are rough and unsourced for now. Corrections are welcome as <a href={SITE.repo}>pull requests</a>.</p>
    </footer>
  </body>
</html>
